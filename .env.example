# Oracle ATP / UCP local example
#
# DB_USER / DB_PASSWORD: credenciales del schema que usa la app (APP_USER típicamente).
# TNS_ADMIN:
#   - Local: ruta a la carpeta wallet (en este repo existe ./forgetask/wallet)
#   - En Docker (docker-compose.dev.yml) ya se monta /wallet y se setea TNS_ADMIN=/wallet
#
# La URL JDBC principal se define en forgetask/src/main/resources/application.properties:
#   spring.datasource.url=jdbc:oracle:thin:@<TNS_ALIAS>?TNS_ADMIN=${TNS_ADMIN}
# Donde <TNS_ALIAS> se obtiene de forgetask/wallet/tnsnames.ora (por ejemplo: ocichatbot26ai_tp)
DB_USER=
DB_PASSWORD=
TNS_ADMIN=

# ─────────────────────────────────────────────────────────────
# Vector DB / RAG (Oracle ADB 26ai)
# ─────────────────────────────────────────────────────────────
# Estos valores son OPCIONALES.
# Si NO los defines, el backend reutiliza la misma conexión principal (spring.datasource.*)
# para las operaciones vectoriales (SPRINT_EMBEDDINGS y VECTOR_EMBEDDING/VECTOR_DISTANCE).
#
# Úsalos SOLO si tu vector store vive en otra DB/usuario o quieres credenciales separadas.
#
# ¿De dónde sale DB_26AI_URL?
#   Opción A (recomendado en este repo): reutilizar wallet+TNS y poner el mismo patrón:
#     DB_26AI_URL=jdbc:oracle:thin:@<TNS_ALIAS>?TNS_ADMIN=/wallet
#   Opción B: OCI Console → Autonomous Database → DB Connection → Connection Strings
#
DB_26AI_URL=
DB_26AI_USER=
DB_26AI_PASSWORD=

# RAG tuning
VECTOR_TOP_K=5
VECTOR_EMBEDDING_MODEL=ADMIN.ALL_MINILM_L12_V2

# Telegram Bot Configuration
TELEGRAM_BOT_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Use a Groq model id you have access to.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_API_URL=https://api.groq.com/openai/v1/
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# Selenium E2E (optional)
E2E_BASE_URL=http://localhost:3000
E2E_API_BASE_URL=http://localhost:8080
E2E_BROWSER=edge
E2E_HEADLESS=false

# Hacer build localmente y push a OCIR
export DOCKER_REGISTRY=
export OCIR_REGION=
export OCIR_NAMESPACE=
export OCIR_USERNAME=
export OCIR_TOKEN=